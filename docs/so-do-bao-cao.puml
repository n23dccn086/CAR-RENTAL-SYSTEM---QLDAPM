' ============================================================ HÌNH F.2
@startuml
title Hình F.2: Sơ đồ ERD các thực thể cốt lõi
skinparam shadowing false
hide methods

class users << (T,#FFAAAA) >> {
  **id** : BIGSERIAL
  --
  name : VARCHAR(100)
  phone : VARCHAR(15) [unique]
  email : VARCHAR(150)
  password_hash : VARCHAR(255)
  role : VARCHAR(20)
  verification_status : VARCHAR(20)
}

class cars << (T,#FFAAAA) >> {
  **id** : BIGSERIAL
  --
  <u>owner_id</u> : BIGINT
  plate : VARCHAR(20) [unique]
  brand : VARCHAR
  model : VARCHAR
  seats : INT
  price_per_day : BIGINT
  price_weekend : BIGINT
  status : VARCHAR(20)
}

class drivers << (T,#FFAAAA) >> {
  **id** : BIGSERIAL
  --
  <u>owner_id</u> : BIGINT
  name : VARCHAR(100)
  phone : VARCHAR(15)
  license_number : VARCHAR
  status : VARCHAR(20)
}

class withdrawals << (T,#FFAAAA) >> {
  **id** : BIGSERIAL
  --
  <u>owner_id</u> : BIGINT
  amount : DECIMAL(12,0)
  net_amount : NUMERIC(12,0)
  status : VARCHAR(20)
}

class notifications << (T,#FFAAAA) >> {
  **id** : BIGSERIAL
  --
  <u>user_id</u> : BIGINT
  title : VARCHAR(255)
  content : TEXT
  is_read : BOOLEAN
}

class bookings << (T,#FFAAAA) >> {
  **id** : BIGSERIAL
  --
  <u>customer_id</u> : BIGINT
  <u>car_id</u> : BIGINT
  <u>owner_id</u> : BIGINT
  start_date : TIMESTAMP
  end_date : TIMESTAMP
  total_price : BIGINT
  deposit_amount : BIGINT
  status : VARCHAR(30)
}

class payments << (T,#FFAAAA) >> {
  **id** : BIGSERIAL
  --
  <u>booking_id</u> : BIGINT
  amount : BIGINT
  payment_type : VARCHAR(20)
  status : VARCHAR(20)
  transaction_id : VARCHAR(100)
}

class handover_records << (T,#FFAAAA) >> {
  **id** : BIGSERIAL
  --
  <u>booking_id</u> : BIGINT
  handover_type : VARCHAR(20)
  km_reading : INT
  status : VARCHAR(20)
  late_fee : NUMERIC
}

class reviews << (T,#FFAAAA) >> {
  **id** : BIGSERIAL
  --
  <u>booking_id</u> : BIGINT
  car_rating : INT
  owner_rating : INT
  comment : TEXT
}

class disputes << (T,#FFAAAA) >> {
  **id** : BIGSERIAL
  --
  <u>booking_id</u> : BIGINT
  raised_by : BIGINT
  against_user : BIGINT
  status : VARCHAR(20)
  resolution : TEXT
}

users "1" -- "0..*" cars : sở hữu >
users "1" -- "0..*" bookings : đặt >
users "1" -- "0..*" drivers : quản lý >
users "1" -- "0..*" withdrawals : rút tiền >
users "1" -- "0..*" notifications : nhận >
cars "1" -- "0..*" bookings : được thuê >
bookings "1" -- "0..*" payments : thanh toán >
bookings "1" -- "0..2" handover_records : biên bản >
bookings "1" -- "0..1" reviews : đánh giá >
bookings "1" -- "0..*" disputes : khiếu nại >
@enduml

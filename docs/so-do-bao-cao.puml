package "Người dùng & xác thực" #F3F7FF {
  entity users {
    * id : BIGSERIAL <<PK>>
    --
    * name : VARCHAR(100)
    * phone : VARCHAR(15) <<UK>>
    email : VARCHAR(150) <<UK>>
    * password_hash : VARCHAR(255)
    * role : VARCHAR(20)  // CUSTOMER|OWNER|DRIVER|ADMIN
    verification_status : VARCHAR(20)
    address, date_of_birth, avatar_url
    rejection_reason : TEXT
    last_login_at : TIMESTAMP
    is_active : BOOLEAN
    created_at, updated_at, deleted_at
  }

  entity user_documents {
    * id : BIGSERIAL <<PK>>
    --
    * user_id : BIGINT <<FK>>
    * document_type : VARCHAR(30)  // GPLX_FRONT|GPLX_BACK|CCCD_FRONT|CCCD_BACK|SELFIE
    * document_url : VARCHAR(500)
    uploaded_at : TIMESTAMP
  }

  entity password_reset_otps {
    * id : BIGSERIAL <<PK>>
    --
    * phone : VARCHAR(15)
    * otp : VARCHAR(6)
    * expires_at : TIMESTAMP
    * is_used : BOOLEAN
    * attempts : INT
    created_at : TIMESTAMP
  }

  entity owner_requests {
    * id : BIGSERIAL <<PK>>
    --
    * user_id : BIGINT <<FK>>
    * full_name, date_of_birth, gender, address
    * cccd, cccd_issued_date, cccd_issued_place
    * bank_name, bank_account, account_holder
    * status : VARCHAR(20)  // PENDING|APPROVED|REJECTED
    rejection_reason : TEXT
    processed_by : BIGINT <<FK>>
    processed_at : TIMESTAMP
    created_at, updated_at, deleted_at
  }

  entity owner_request_documents {
    * id : BIGSERIAL <<PK>>
    --
    * request_id : BIGINT <<FK>>
    * document_type : VARCHAR(30)
    * document_url : VARCHAR(500)
    uploaded_at : TIMESTAMP
  }
}


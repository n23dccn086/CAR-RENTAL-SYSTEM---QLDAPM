# ==============================================================================
# CAR RENTAL SYSTEM - BACKEND ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================
# Sao chép file này thành .env trong thư mục backend/ và điền thông tin thực tế:
#   cp .env.example .env   (hoặc copy trên Windows)
#
# Backend Spring Boot tự động load file .env khi khởi động.
# Lưu ý: ai-service có file .env riêng trong thư mục ai-service/.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
HOST_POSTGRES=localhost
PORT_POSTGRES=5432
USER_POSTGRES=postgres
PASSWORD_POSTGRES=123456
DB_POSTGRES=car_rental
SSLMODE_POSTGRES=disable

# Tùy chọn: URL đầy đủ (nếu dùng biến này thì sẽ ghi đè các cấu hình host/port lẻ ở trên)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/car_rental?sslmode=disable
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=123456

# ------------------------------------------------------------------------------
# 2. REDIS CONFIGURATION (Cache & Session / Token blacklist)
# ------------------------------------------------------------------------------
HOST_REDIS=localhost
PORT_REDIS=6379
PASSWORD_REDIS=
DB_REDIS=0

# ------------------------------------------------------------------------------
# 3. SERVER & API CONFIGURATION
# ------------------------------------------------------------------------------
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api/v1

# ------------------------------------------------------------------------------
# 4. JWT SECURITY CONFIGURATION
# ------------------------------------------------------------------------------
# Secret key base64 tối thiểu 256-bit
JWT_SECRET=Y2FyLXJlbnRhbC1zeXN0ZW0tc3VwZXItc2VjcmV0LWtleS0yMDI2LTI1Ni1iaXRz
# Thời gian sống Access Token (ms) - 3600000 = 1 giờ
JWT_EXPIRATION=3600000
# Thời gian sống Refresh Token (ms) - 604800000 = 7 ngày
JWT_REFRESH_EXPIRATION=604800000

# ------------------------------------------------------------------------------
# 5. MOMO PAYMENT GATEWAY (Module 5)
# ------------------------------------------------------------------------------
PAYMENT_MOMO_PARTNER_CODE=DEMO
PAYMENT_MOMO_ACCESS_KEY=DEMO_ACCESS
PAYMENT_MOMO_SECRET_KEY=DEMO_SECRET
PAYMENT_MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
PAYMENT_MOMO_RETURN_URL=http://localhost:8080/api/v1/payments/callback/momo
PAYMENT_MOMO_NOTIFY_URL=http://localhost:8080/api/v1/payments/callback/momo

# ------------------------------------------------------------------------------
# 6. FILE STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
APP_UPLOAD_DIR=uploads
